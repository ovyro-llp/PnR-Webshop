# ==============================================================================
# PUFFS 'N' ROLLS - PRODUCTION ENVIRONMENT CONFIGURATION
# Fill in your live production credentials in Railway
# ==============================================================================

# 1. DATABASE CONFIGURATION (Railway PostgreSQL)
DATABASE_URL=

# 2. WEB APPLICATION DOMAIN
NEXT_PUBLIC_APP_URL=https://shop.puffsnrolls.com

# 3. RAZORPAY PAYMENT GATEWAY (LIVE PRODUCTION)
# Paste your Razorpay Live credentials below:
RAZORPAY_ENV=live
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# 4. MANGWALE LOGISTICS ENTERPRISE API (NASHIK HYPERLOCAL FLEET)
# Paste your Mangwale Live credentials below:
MANGWALE_ENV=live
MANGWALE_API_KEY=
MANGWALE_API_SECRET=
MANGWALE_WEBHOOK_SECRET=

# 5. MARKETING & ANALYTICS (OPTIONAL)
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_GOOGLE_ADS_ID=
